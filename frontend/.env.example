# URL base del backend. Por defecto http://localhost:8001 si no se define.
# Apunta esto al preview de Emergent para probar contra el backend real.
VITE_API_URL=http://localhost:8001

# Client ID de Google (el mismo que GOOGLE_CLIENT_ID del backend).
# Es publico por diseno. Vacio = boton de Google oculto.
VITE_GOOGLE_CLIENT_ID=
