# Cadena de conexion de MongoDB. En Atlas: Connect > Drivers.
# NUNCA la pegues en el repo ni en un chat: va en el panel del proveedor.
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net

DB_NAME=gymbro

# Cadena larga y aleatoria. Generala con: openssl rand -hex 32
JWT_SECRET=cambiame

# Origenes permitidos, separados por coma. Los dominios *.vercel.app ya
# estan permitidos por patron en server.py; esto es para dominio propio.
CORS_ORIGINS=http://localhost:5173

# ── Acceso con Google ──
# Client ID de tipo "Aplicacion web" de Google Cloud Console.
# Es publico (va tambien en el frontend). Si se deja vacio, la app oculta
# el boton de Google en vez de mostrar uno roto.
GOOGLE_CLIENT_ID=

# ── Correo para recuperar contrasena ──
# Vale cualquier SMTP: Gmail con contrasena de aplicacion, Resend, SendGrid.
# Sin SMTP_HOST no se envian correos: el enlace se escribe en el log y el
# endpoint sigue respondiendo lo mismo, para no delatar que cuentas existen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GymBro <no-reply@tudominio.com>

# URL publica de la app, para construir el enlace del correo.
APP_URL=https://tu-dominio-de-produccion

# ── Entrenador con IA ──
# Clave de Google AI Studio (aistudio.google.com/apikey). ES SECRETA.
# Sin ella, /coach sigue funcionando con el motor de reglas; solo se apaga
# la redaccion en lenguaje natural y /coach/ask responde 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
