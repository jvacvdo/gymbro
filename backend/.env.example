# Cadena de conexion de MongoDB. En Atlas: Connect > Drivers.
# NUNCA la pegues en el repo ni en un chat: va en el panel del proveedor.
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net

DB_NAME=gymbro

# Cadena larga y aleatoria. Generala con: openssl rand -hex 32
JWT_SECRET=cambiame

# Origenes permitidos, separados por coma. Los dominios *.vercel.app ya
# estan permitidos por patron en server.py; esto es para dominio propio.
CORS_ORIGINS=http://localhost:5173
